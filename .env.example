# ============================================================
# 奇妙小站 · 配置模板
# 用法：cp .env.example .env 然后按需修改
# 注意：真实 .env 永远不入 Git（已在 .gitignore 里）
# ============================================================

# ---- 站点信息 ----
SITE_NAME=奇妙小站
SITE_SLOGAN=慢慢做，不着急。
SITE_OWNER=搭子
SITE_INTRO=这里是我折腾各种小东西的地方——写点随笔、做点小工具，偶尔冒出一些奇思妙想。
SITE_VERSION=0.2

# ---- 运行环境：production / development ----
ENV=production

# ---- 启用的功能模块（逗号分隔目录名）----
# 新增模块在这里登记；禁用模块从这里删名字；改完重启容器生效
# 留空 = 只保留首页/关于/404 这些核心页面（实验室/随机问候属于站点本体，不受影响）
MODULES_ENABLED=todo,notes

# ---- 数据目录（SQLite 库文件目录，Docker 里挂载到宿主机 ./data）----
DATA_DIR=data

# ---- 以后需要密钥时加在这里（例如 SMTP、各类 API Key），.env 不入库 ----
